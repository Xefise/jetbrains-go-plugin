<!-- Modified from go-language-helper (cag11), commit 556c274, Apache-2.0: extension registrations -->
<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude">
    <id>io.github.xefise.golsp</id>
    <name>Go (gopls)</name>
    <vendor>Xefise</vendor>
    <description><![CDATA[
        <p>Go support for WebStorm and other JetBrains IDEs without the official Go plugin:
        language features via gopls (LSP4IJ), debugging via Delve DAP, run configurations and a test runner.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.redhat.devtools.lsp4ij</depends>
    <depends>com.intellij.platform.testRunner</depends>
    <depends>com.intellij.modules.coverage</depends>

    <incompatible-with>org.jetbrains.plugins.go</incompatible-with>
    <incompatible-with>io.github.cag11.go-language-helper</incompatible-with>
    <incompatible-with>io.genai.go</incompatible-with>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="golsp.go"
                  implementationClass="io.github.xefise.golsp.lang.GoFileType"
                  fieldName="INSTANCE"
                  language="golsp.go"
                  extensions="go"/>
        <lang.parserDefinition language="golsp.go"
                               implementationClass="io.github.xefise.golsp.lang.GoParserDefinition"/>
        <fileType name="golsp.gomod"
                  implementationClass="io.github.xefise.golsp.lang.GoModFileType"
                  fieldName="INSTANCE"
                  language="golsp.gomod"
                  fileNames="go.mod"/>
        <fileType name="golsp.gowork"
                  implementationClass="io.github.xefise.golsp.lang.GoWorkFileType"
                  fieldName="INSTANCE"
                  language="golsp.gowork"
                  fileNames="go.work"/>
        <fileType name="golsp.gosum"
                  implementationClass="io.github.xefise.golsp.lang.GoSumFileType"
                  fieldName="INSTANCE"
                  fileNames="go.sum;go.work.sum"/>
        <lang.parserDefinition language="golsp.gomod"
                               implementationClass="io.github.xefise.golsp.lang.GoModParserDefinition"/>
        <lang.parserDefinition language="golsp.gowork"
                               implementationClass="io.github.xefise.golsp.lang.GoWorkParserDefinition"/>
        <lang.syntaxHighlighterFactory language="golsp.go"
                                       implementationClass="io.github.xefise.golsp.lang.GoSyntaxHighlighterFactory"/>
        <lang.syntaxHighlighterFactory language="golsp.gomod"
                                       implementationClass="io.github.xefise.golsp.lang.GoModSyntaxHighlighterFactory"/>
        <lang.syntaxHighlighterFactory language="golsp.gowork"
                                       implementationClass="io.github.xefise.golsp.lang.GoWorkSyntaxHighlighterFactory"/>
        <colorSettingsPage implementation="io.github.xefise.golsp.lang.GoColorSettingsPage"/>
        <langCodeStyleSettingsProvider implementation="io.github.xefise.golsp.lang.GoLanguageCodeStyleSettingsProvider"/>
        <lang.commenter language="golsp.go" implementationClass="io.github.xefise.golsp.lang.GoCommenter"/>
        <lang.commenter language="golsp.gomod" implementationClass="io.github.xefise.golsp.lang.GoModCommenter"/>
        <lang.commenter language="golsp.gowork" implementationClass="io.github.xefise.golsp.lang.GoModCommenter"/>
        <lang.braceMatcher language="golsp.go" implementationClass="io.github.xefise.golsp.lang.GoBraceMatcher"/>
        <lang.braceMatcher language="golsp.gomod" implementationClass="io.github.xefise.golsp.lang.GoModBraceMatcher"/>
        <lang.braceMatcher language="golsp.gowork" implementationClass="io.github.xefise.golsp.lang.GoWorkBraceMatcher"/>
        <lang.quoteHandler language="golsp.go" implementationClass="io.github.xefise.golsp.lang.GoQuoteHandler"/>
        <lang.quoteHandler language="golsp.gomod" implementationClass="io.github.xefise.golsp.lang.GoModQuoteHandler"/>
        <lang.quoteHandler language="golsp.gowork" implementationClass="io.github.xefise.golsp.lang.GoWorkQuoteHandler"/>
        <lineIndentProvider implementation="io.github.xefise.golsp.lang.GoLineIndentProvider"/>
        <extendWordSelectionHandler implementation="io.github.xefise.golsp.lang.GoWordSelectioner"/>
        <typedHandler implementation="io.github.xefise.golsp.lang.GoTypedHandler"/>
        <typedHandler implementation="io.github.xefise.golsp.lsp.GoParameterInfoTypedHandler"/>
        <lang.smartEnterProcessor language="golsp.go" implementationClass="io.github.xefise.golsp.lang.GoSmartEnterProcessor"/>
        <localInspection language="golsp.go" shortName="GoForeignSyntax" displayName="Syntax from another language"
                         groupName="Go" enabledByDefault="true" level="WARNING"
                         implementationClass="io.github.xefise.golsp.lang.GoForeignSyntaxInspection"/>
        <fileIconProvider implementation="io.github.xefise.golsp.lang.GoTestFileIconProvider"/>
        <internalFileTemplate name="Go File"/>
        <internalFileTemplate name="Go Application"/>
        <liveTemplateContext contextId="GOLSP_GO" implementation="io.github.xefise.golsp.lang.GoAnyContextType"/>
        <liveTemplateContext contextId="GOLSP_GO_TOP_LEVEL" baseContextId="GOLSP_GO"
                             implementation="io.github.xefise.golsp.lang.GoTopLevelContextType"/>
        <liveTemplateContext contextId="GOLSP_GO_STATEMENT" baseContextId="GOLSP_GO"
                             implementation="io.github.xefise.golsp.lang.GoStatementContextType"/>
        <defaultLiveTemplates file="/liveTemplates/Go.xml"/>
        <liveTemplateOptionalProcessor implementation="io.github.xefise.golsp.lang.GoSelectionIndentProcessor"/>

        <!-- LSP4IJ binds these to TEXT/textmate only; a custom language has to register them itself. -->
        <lang.foldingBuilder language="golsp.go"
                             implementationClass="com.redhat.devtools.lsp4ij.features.foldingRange.LSPFoldingRangeBuilder"
                             order="first"/>
        <codeInsight.parameterInfo language="golsp.go"
                                   implementationClass="io.github.xefise.golsp.lsp.GoParameterInfoHandler"/>
        <lang.psiStructureViewFactory language="golsp.go"
                                      implementationClass="com.redhat.devtools.lsp4ij.features.documentSymbol.LSPDocumentSymbolStructureViewFactory"/>
        <codeBlockProvider language="golsp.go"
                           implementationClass="com.redhat.devtools.lsp4ij.features.codeBlockProvider.LSPCodeBlockProvider"
                           order="first"/>
        <callHierarchyProvider language="golsp.go"
                               implementationClass="com.redhat.devtools.lsp4ij.features.callHierarchy.LSPCallHierarchyProvider"/>
        <typeHierarchyProvider language="golsp.go"
                               implementationClass="com.redhat.devtools.lsp4ij.features.typeHierarchy.LSPTypeHierarchyProvider"/>
        <lang.importOptimizer language="golsp.go"
                              implementationClass="io.github.xefise.golsp.lsp.GoImportOptimizer"/>
        <lang.refactoringSupport language="golsp.go"
                                 implementationClass="io.github.xefise.golsp.lsp.GoRefactoringSupportProvider"/>
        <inlineActionHandler implementation="io.github.xefise.golsp.lsp.GoInlineActionHandler"/>
        <intentionAction>
            <language>golsp.go</language>
            <className>io.github.xefise.golsp.lsp.GoRefactoringsIntention</className>
            <category>Go</category>
            <skipBeforeAfter>true</skipBeforeAfter>
        </intentionAction>
        <intentionAction>
            <language>golsp.go</language>
            <className>io.github.xefise.golsp.lsp.GoFillStructIntention</className>
            <category>Go</category>
            <skipBeforeAfter>true</skipBeforeAfter>
        </intentionAction>
        <codeInsight.template.postfixTemplateProvider language="golsp.go"
                                                      implementationClass="io.github.xefise.golsp.lang.GoPostfixTemplateProvider"/>
        <formatOnSaveOptions.defaultsProvider implementation="io.github.xefise.golsp.lsp.GoActionsOnSaveDefaults"/>
        <configurationType implementation="io.github.xefise.golsp.run.GoApplicationConfigurationType"/>
        <runConfigurationProducer implementation="io.github.xefise.golsp.run.GoApplicationRunConfigurationProducer"/>
        <configurationType implementation="io.github.xefise.golsp.test.GoTestConfigurationType"/>
        <configurationType implementation="io.github.xefise.golsp.debug.GoRemoteDebugConfigurationType"/>
        <configurationType implementation="io.github.xefise.golsp.debug.GoAttachConfigurationType"/>
        <runLineMarkerContributor language="golsp.go"
                                  implementationClass="io.github.xefise.golsp.run.GoApplicationRunLineMarkerContributor"/>
        <runConfigurationProducer implementation="io.github.xefise.golsp.test.GoTestRunConfigurationProducer"/>
        <runLineMarkerContributor language="golsp.go"
                                  implementationClass="io.github.xefise.golsp.test.GoTestRunLineMarkerContributor"/>
        <postStartupActivity implementation="io.github.xefise.golsp.toolchain.GoToolchainStartupActivity"/>
        <notificationGroup id="Go Tools" displayType="BALLOON"/>
        <projectConfigurable parentId="language"
                             id="golsp.settings"
                             displayName="Go"
                             nonDefaultProject="true"
                             instance="io.github.xefise.golsp.toolchain.GoToolchainConfigurable"/>
        <projectConfigurable parentId="golsp.settings"
                             id="golsp.settings.gopls"
                             displayName="gopls"
                             nonDefaultProject="true"
                             instance="io.github.xefise.golsp.lsp.GoplsConfigurable"/>
        <platform.lang.lsWidget.itemsProvider implementation="io.github.xefise.golsp.lsp.GoplsWidgetItemsProvider"/>
        <!-- gopls hint kinds: providerId and optionId values are persisted in editor.xml; option ids are gopls `hints` keys. -->
        <codeInsight.declarativeInlayProvider language="golsp.go" providerId="go.gopls.types" group="TYPES_GROUP"
                                              isEnabledByDefault="true" bundle="messages.GoLspBundle"
                                              nameKey="inlay.gopls.types.name" descriptionKey="inlay.gopls.types.description"
                                              implementationClass="io.github.xefise.golsp.lsp.GoplsInlayHintsProvider">
            <option optionId="assignVariableTypes" enabledByDefault="true" bundle="messages.GoLspBundle"
                    nameKey="inlay.gopls.assignVariableTypes.name" descriptionKey="inlay.gopls.assignVariableTypes.description"/>
            <option optionId="rangeVariableTypes" enabledByDefault="true" bundle="messages.GoLspBundle"
                    nameKey="inlay.gopls.rangeVariableTypes.name" descriptionKey="inlay.gopls.rangeVariableTypes.description"/>
            <option optionId="compositeLiteralTypes" enabledByDefault="false" bundle="messages.GoLspBundle"
                    nameKey="inlay.gopls.compositeLiteralTypes.name" descriptionKey="inlay.gopls.compositeLiteralTypes.description"/>
            <option optionId="functionTypeParameters" enabledByDefault="false" bundle="messages.GoLspBundle"
                    nameKey="inlay.gopls.functionTypeParameters.name" descriptionKey="inlay.gopls.functionTypeParameters.description"/>
        </codeInsight.declarativeInlayProvider>
        <codeInsight.declarativeInlayProvider language="golsp.go" providerId="go.gopls.parameters" group="PARAMETERS_GROUP"
                                              isEnabledByDefault="true" bundle="messages.GoLspBundle"
                                              nameKey="inlay.gopls.parameters.name" descriptionKey="inlay.gopls.parameters.description"
                                              implementationClass="io.github.xefise.golsp.lsp.GoplsInlayHintsProvider">
            <option optionId="parameterNames" enabledByDefault="false" bundle="messages.GoLspBundle"
                    nameKey="inlay.gopls.parameterNames.name" descriptionKey="inlay.gopls.parameterNames.description"/>
            <option optionId="compositeLiteralFields" enabledByDefault="false" bundle="messages.GoLspBundle"
                    nameKey="inlay.gopls.compositeLiteralFields.name" descriptionKey="inlay.gopls.compositeLiteralFields.description"/>
        </codeInsight.declarativeInlayProvider>
        <codeInsight.declarativeInlayProvider language="golsp.go" providerId="go.gopls.values" group="VALUES_GROUP"
                                              isEnabledByDefault="true" bundle="messages.GoLspBundle"
                                              nameKey="inlay.gopls.values.name" descriptionKey="inlay.gopls.values.description"
                                              implementationClass="io.github.xefise.golsp.lsp.GoplsInlayHintsProvider">
            <option optionId="constantValues" enabledByDefault="false" bundle="messages.GoLspBundle"
                    nameKey="inlay.gopls.constantValues.name" descriptionKey="inlay.gopls.constantValues.description"/>
            <option optionId="ignoredError" enabledByDefault="false" bundle="messages.GoLspBundle"
                    nameKey="inlay.gopls.ignoredError.name" descriptionKey="inlay.gopls.ignoredError.description"/>
        </codeInsight.declarativeInlayProvider>
        <codeInsight.declarativeInlayProviderCustomSettingsProvider language="golsp.go" providerId="go.gopls.types"
                                                                    implementationClass="io.github.xefise.golsp.lsp.GoplsInlayHintsApplyListener"/>
        <codeInsight.declarativeInlayProviderCustomSettingsProvider language="golsp.go" providerId="go.gopls.parameters"
                                                                    implementationClass="io.github.xefise.golsp.lsp.GoplsInlayHintsApplyListener"/>
        <codeInsight.declarativeInlayProviderCustomSettingsProvider language="golsp.go" providerId="go.gopls.values"
                                                                    implementationClass="io.github.xefise.golsp.lsp.GoplsInlayHintsApplyListener"/>
        <editorNotificationProvider implementation="io.github.xefise.golsp.toolchain.GoToolBannerProvider"/>
        <coverageEngine implementation="io.github.xefise.golsp.coverage.GoCoverageEngine"/>
        <coverageRunner implementation="io.github.xefise.golsp.coverage.GoCoverageRunner"/>
        <programRunner implementation="io.github.xefise.golsp.coverage.GoCoverageProgramRunner"/>
        <executor implementation="io.github.xefise.golsp.execution.GoRaceExecutor"/>
        <programRunner implementation="io.github.xefise.golsp.execution.GoRaceProgramRunner"/>
    </extensions>

    <!-- One inspection per gopls analyzer, generated by `./gradlew generateGoplsAnalyzers`. -->
    <xi:include href="/META-INF/golsp-gopls-analyzers.xml" xpointer="xpointer(/idea-plugin/*)"/>

    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
        <server id="gopls"
                name="Go (gopls)"
                factoryClass="io.github.xefise.golsp.lsp.GoplsLanguageServerFactory">
            <description><![CDATA[Go language server <a href="https://go.dev/gopls">gopls</a>.]]></description>
        </server>
        <languageMapping language="golsp.go" serverId="gopls" languageId="go"/>
        <languageMapping language="golsp.gomod" serverId="gopls" languageId="go.mod"/>
        <languageMapping language="golsp.gowork" serverId="gopls" languageId="go.work"/>
        <semanticTokensColorsProvider serverId="gopls"
                                      class="io.github.xefise.golsp.lsp.GoSemanticTokensColorsProvider"/>
        <debugAdapterServer id="go-delve"
                            name="Go (Delve)"
                            factoryClass="io.github.xefise.golsp.debug.GoDelveDescriptorFactory"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij.xdebugger">
        <attachDebuggerProvider implementation="io.github.xefise.golsp.debug.GoAttachDebuggerProvider"/>
    </extensions>

    <actions>
        <action id="golsp.NewGoFile" class="io.github.xefise.golsp.lang.GoCreateFileAction">
            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="NewDir"/>
        </action>
        <action id="golsp.GoRefactorings" class="io.github.xefise.golsp.lsp.GoRefactoringsAction"
                text="Go Refactorings…" description="Choose one of the gopls refactorings available at the caret">
            <add-to-group group-id="RefactoringMenu" anchor="last"/>
        </action>
    </actions>

    <applicationListeners>
        <listener class="io.github.xefise.golsp.toolchain.GoToolchainTrustListener"
                  topic="com.intellij.ide.trustedProjects.TrustedProjectsListener"/>
    </applicationListeners>

    <projectListeners>
        <listener class="io.github.xefise.golsp.lsp.GoplsToolchainListener"
                  topic="io.github.xefise.golsp.toolchain.GoToolchainListener"/>
        <listener class="io.github.xefise.golsp.toolchain.GoToolchainSettingsRefresher"
                  topic="io.github.xefise.golsp.toolchain.GoToolchainSettingsListener"/>
        <listener class="io.github.xefise.golsp.toolchain.GoToolStatusRefresher"
                  topic="io.github.xefise.golsp.toolchain.GoToolchainListener"/>
        <listener class="io.github.xefise.golsp.toolchain.GoToolBannerRefresher"
                  topic="io.github.xefise.golsp.toolchain.GoToolchainListener"/>
        <listener class="io.github.xefise.golsp.toolchain.GoToolBannerRefresher"
                  topic="io.github.xefise.golsp.toolchain.GoToolStatusListener"/>
        <listener class="io.github.xefise.golsp.lsp.GoplsSettingsListener"
                  topic="io.github.xefise.golsp.toolchain.GoToolchainSettingsListener"/>
        <listener class="io.github.xefise.golsp.lsp.GoplsToolInstallListener"
                  topic="io.github.xefise.golsp.toolchain.GoToolInstallListener"/>
        <listener class="io.github.xefise.golsp.lsp.GoParameterInfoLookupListener"
                  topic="com.intellij.codeInsight.lookup.LookupManagerListener"/>
        <listener class="io.github.xefise.golsp.lsp.GoplsInspectionProfileListener"
                  topic="com.intellij.profile.ProfileChangeAdapter"/>
    </projectListeners>
</idea-plugin>
